{
  "name": "tokenpulse",
  "productName": "TokenPulse",
  "version": "0.1.4",
  "description": "Local-first tray monitor for AI agent token usage — 消耗看得清、成本可控、实时感知",
  "main": "out/main/index.js",
  "author": "TokenPulse contributors",
  "license": "MIT",
  "scripts": {
    "start": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "icon": "node build/gen-icon.mjs",
    "package": "npm run icon && electron-vite build && electron-builder --win portable nsis"
  },
  "build": {
    "appId": "io.github.tokenpulse.app",
    "productName": "TokenPulse",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**"
    ],
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false
    }
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^5.0.0"
  },
  "allowScripts": {
    "electron@44.2.0": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "electron-winstaller@5.4.0": true
  },
  "dependencies": {
    "lucide-react": "^1.41.0"
  }
}
